{
  "name": "social-media-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:check": "tsx scripts/check-database.ts",
    "tokens:migrate": "tsx scripts/migrate-tokens-to-cloud.ts",
    "images:migrate": "tsx scripts/migrate-scheduled-images-to-cloud.ts",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
