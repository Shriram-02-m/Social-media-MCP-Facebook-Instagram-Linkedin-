# Shared fallback Developer App credentials. Users who have not saved their own
# app credentials in Developer App Settings fall back to these, and the local
# (stdio) MCP server always uses them.
META_APP_ID=
META_APP_SECRET=

# Instagram Login credentials from Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Supabase PostgreSQL connection URI. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Server-side credentials for the private Supabase Storage bucket and cloud worker.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_STORE_BACKEND=local
SCHEDULED_IMAGE_STORAGE=local
SCHEDULER_MODE=local
# Use a second independently generated key for AES-256-GCM cloud token records.
CLOUD_TOKEN_ENCRYPTION_KEY=
# Encrypts user-owned Developer App secrets (AES-256-GCM) saved from the Accounts
# page. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in every runtime that encrypts or decrypts an app secret: the web API
# on Vercel (encrypts on save) and the cloud worker on Render (decrypts during the
# OAuth code exchange and LinkedIn token refresh). Both runtimes must share the
# SAME key. A local (stdio) MCP install uses TOKEN_STORE_BACKEND=local and keeps
# using the shared META_/INSTAGRAM_/LINKEDIN_ credentials above, so it can leave
# this unset. Never commit a production key.
APP_CREDENTIAL_ENCRYPTION_KEY=
# Shared by the Render worker and Supabase Vault; generate with node:crypto.
WORKER_TRIGGER_SECRET=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SOCIAL_MCP_TOKEN_ENCRYPTION_KEY=

# Identity used by the single-user stdio MCP server and by rows/credentials created
# before multi-user support existed. The web app always passes the signed-in user id.
MCP_OWNER_USER_ID=local-owner

# Configure the ngrok URL and local HTTP image/OAuth server port. MCP itself uses stdio.
# IMAGE_PUBLIC_BASE_URL should match the public HTTPS ngrok URL and OAUTH_REDIRECT_BASE_URL.
IMAGE_PUBLIC_BASE_URL=
IMAGE_SERVER_PORT=8787
# OAUTH_CALLBACK_PORT is kept as a backwards-compatible fallback for IMAGE_SERVER_PORT.
OAUTH_REDIRECT_BASE_URL=http://localhost:8787
OAUTH_CALLBACK_PORT=8787

# How browser OAuth callbacks are handled. `local` (default) keeps the localhost/ngrok
# listener and in-memory authorization sessions. `cloud` persists sessions in PostgreSQL
# and receives callbacks on the public worker routes (/oauth/meta/callback and
# /oauth/linkedin/callback). Set `cloud` on both Render and Vercel for production.
# OAUTH_REDIRECT_BASE_URL must then be the public HTTPS worker URL, for example
# https://social-media-cloud-worker.onrender.com.
OAUTH_CALLBACK_MODE=local
# Deployed frontend origin (Vercel). Cloud callbacks redirect here to the fixed
# /accounts page and the remote MCP consent flow redirects to /mcp/authorize.
# Required when OAUTH_CALLBACK_MODE=cloud. Do not invent a hostname; use the real
# deployed project URL.
OAUTH_FRONTEND_BASE_URL=

# --- Remote MCP (Claude.ai / Claude Code) ---
# Public Streamable HTTP MCP endpoint served by the cloud worker. This value is
# also the RFC 8707 resource indicator bound into access tokens, so it must match
# the connector URL configured in Claude. Defaults to
# ${OAUTH_REDIRECT_BASE_URL}/mcp when unset. The Vercel deployment must use the
# same value.
MCP_PUBLIC_URL=https://social-media-cloud-worker.onrender.com/mcp
# The single OAuth scope this server supports. Must match on Render and Vercel.
MCP_OAUTH_SCOPE=mcp
# One-time authorization-code, access-token, and refresh-token lifetimes in
# seconds. Defaults: 300, 3600, and 2592000 (30 days).
MCP_AUTHORIZATION_CODE_TTL_SECONDS=300
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
# Dynamic Client Registration only accepts callbacks under these HTTPS origins.
# Comma- or space-separated origins. Must match on Render and Vercel.
MCP_ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://claude.com
# Allow Claude Code's loopback HTTP callbacks (for example
# http://localhost:3118/callback). Set to false to require HTTPS callbacks only.
MCP_ALLOW_LOOPBACK_REDIRECTS=true
# Lifetime of a single-use MCP media upload intent (social_upload_media_intent).
# Default 900 seconds (15 minutes), max 3600. The intent caps one upload of the
# declared kind; the tool result's storagePath is permanent regardless.
MCP_UPLOAD_INTENT_TTL_SECONDS=900
# Maximum upload intents per authenticated user per rolling 10-minute window,
# enforced per cloud-worker process. Default 20, max 200.
MCP_UPLOAD_INTENT_RATE_LIMIT=20

SCHEDULE_IMAGE_TIMEOUT_MS=10000
SCHEDULE_IMAGE_MAX_BYTES=10485760
SCHEDULE_IMAGE_MAX_ATTEMPTS=3
SCHEDULE_IMAGE_RETRY_BASE_DELAY_MS=1000
SCHEDULE_IMAGE_RETRY_MAX_DELAY_MS=30000
# Maximum size for an optional LinkedIn PDF document attached to a scheduled post.
SCHEDULE_DOCUMENT_MAX_BYTES=10485760
# Maximum size for a scheduled video. Must not exceed the 50 MiB private bucket limit.
SCHEDULE_VIDEO_MAX_BYTES=52428800
# Maximum number of media items per post (Instagram carousel limit is 10).
SCHEDULE_MEDIA_MAX_ITEMS=10
# Lifetime (seconds) of the Supabase Storage signed URL created at publish time.
# Never stored; regenerated for each attempt. Only needs to outlive the
# destination platform's fetch. Default 86400 (24h), max 604800 (7d).
SCHEDULE_SIGNED_URL_TTL_SECONDS=86400

META_GRAPH_API_VERSION=v25.0
LINKEDIN_API_VERSION=202609
LINKEDIN_SCOPES=openid profile w_member_social
META_FACEBOOK_PAGE_ID=
LINKEDIN_AUTHOR_URN=