# Vercel (serverless) MUST use the Supabase Transaction Pooler on port 6543.
# Session mode (port 5432) gives every warm isolate a dedicated PostgreSQL
# session; enough warm/overlapping instances exhaust the session pool and new
# connections are rejected with EMAXCONNSESSION, which surfaces as a 503
# "Can't verify your session". The web app uses exactly one pg pool of size 1
# per instance, shared with the imported backend modules.
# Transaction pooler (VERCEL ONLY):
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Render (long-lived worker) keeps its OWN DATABASE_URL in the Render dashboard:
#   Session pooler: postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   or direct:      postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Do not reuse the Vercel transaction URL on Render: its explicit BEGIN/FOR UPDATE
# transactions should stay on one dedicated backend connection.
# When the URL has no sslmode parameter, the app still enforces TLS for
# *.supabase.co hosts automatically.
# DATABASE_URL=
# REQUIRED in production (Vercel): must be the remote PostgreSQL pooler URL.
# There is intentionally NO localhost fallback - a missing DATABASE_URL or a
# localhost/127.0.0.1/::1 URL fails fast at runtime with a clear error instead
# of silently connecting to 127.0.0.1:5432 and returning HTTP 500 on sign-in.
# Local development may leave this unset to use a locally running PostgreSQL.

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Local development default. In Vercel set BETTER_AUTH_URL to the deployed
# domain below (no trailing slash) so Better Auth baseURL and CSRF match:
#   https://social-media-web-brown.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Better Auth trusted origins (CSRF/origin check) ---
# The canonical production origin is always trusted:
#   https://social-media-web-brown.vercel.app
# Vercel's own VERCEL_URL and VERCEL_BRANCH_URL are added automatically for each
# deployment, so preview deployments do not need manual configuration. List any
# OTHER explicitly approved preview origin here as full https:// origins,
# comma-separated. Exact matches only: wildcards, paths, query strings and
# http:// origins in production are rejected. Never use a wildcard or disable
# CSRF/origin validation.
# BETTER_AUTH_TRUSTED_ORIGINS=https://approved-preview.vercel.app,https://another-preview.vercel.app

# Used ONLY by scripts/seed-admin.mts to provision the single admin account.
# Never use this value as a login-form default or expose it to the client:
# local development values can be stale and must not appear in production UI.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Public sign-up is enabled by default. Set to false to restrict account creation to scripts/seed-admin.ts.
ALLOW_ADMIN_SIGNUP=true

# --- Security email delivery (OTP password recovery) ---
# Password recovery emails a 6-digit, single-use code that expires in 5 minutes.
# Configure ONE transport. Never put these values in NEXT_PUBLIC_* or the client.
# Resend (recommended):
# RESEND_API_KEY=
# EMAIL_FROM="Social Console <security@your-domain.example>"
# EMAIL_APP_NAME=Social Console
# ...or a generic HTTPS webhook that accepts { to, subject, text }:
# EMAIL_DELIVERY_URL=
# EMAIL_DELIVERY_TOKEN=

# --- Emergency Super Admin recovery (offline CLI only) ---
# There is no HTTP endpoint for this. Run: npm run db:recover-admin
# The acknowledgement phrase is required so an accidental run cannot rotate the
# administrator password or revoke sessions.
# RECOVER_ADMIN_ACKNOWLEDGE=recover-super-admin
# ADMIN_NEW_PASSWORD=

# --- Backend OAuth configuration (read by the compiled social-media-mcp modules) ---
# The frontend imports the backend from ../social-media-mcp/dist, so these must be
# present in the Vercel environment. Set OAUTH_CALLBACK_MODE=cloud for production.
# Only public client IDs are needed here; never put Meta/Instagram/LinkedIn client
# secrets or CLOUD_TOKEN_ENCRYPTION_KEY on Vercel.
# OAUTH_CALLBACK_MODE=cloud
# OAUTH_REDIRECT_BASE_URL=https://social-media-cloud-worker.onrender.com
# OAUTH_FRONTEND_BASE_URL=https://YOUR-VERCEL-PROJECT.vercel.app
# META_APP_ID=
# INSTAGRAM_APP_ID=
# LINKEDIN_CLIENT_ID=

# --- Remote MCP consent (Render authorization server) ---
# The Vercel app renders the consent screen and creates the one-time code, so it
# must validate the same MCP resource, scope, and redirect-origin allowlist as the
# Render worker. These values are public and must match Render exactly.
# MCP_PUBLIC_URL=https://social-media-cloud-worker.onrender.com/mcp
# MCP_OAUTH_SCOPE=mcp
# MCP_ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://claude.com
# MCP_ALLOW_LOOPBACK_REDIRECTS=true

# Required on Vercel: POST /api/credentials encrypts each user's Developer App
# secret before it is stored in PostgreSQL. This MUST be the same 32-byte key as
# the Render worker (which decrypts during the OAuth exchange and LinkedIn
# refresh). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never expose it through NEXT_PUBLIC_*, a client bundle, an API response, or logs.
# APP_CREDENTIAL_ENCRYPTION_KEY=

# --- Remote media upload (POST /api/media/upload) ---
# Required when signed-in users need to turn a local image, video, or PDF into a
# durable media reference for remote MCP tools (Claude.ai cannot attach files to
# a remote tool). The endpoint stores the file under a per-user prefix in the
# private `social-media-images` bucket and returns the permanent object path
# (`storagePath`); scheduling tools persist that path and the worker re-downloads
# it at publish time. Server-side only: never expose SUPABASE_SERVICE_ROLE_KEY
# through NEXT_PUBLIC_*, a client bundle, an API response, or logs. The bucket
# must stay private.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Lifetime in seconds of the signed URL the worker creates at publish time (not
# stored; regenerated for every attempt). Default 86400, max 604800. Only needs
# to outlive the destination platform's fetch of the media.
# SCHEDULE_SIGNED_URL_TTL_SECONDS=86400
